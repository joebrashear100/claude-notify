{
  "name": "claude-notify",
  "version": "0.1.0",
  "description": "A small, dependency-free notification library and CLI with pluggable channels (console, webhook/Slack/Discord).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "claude-notify": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:monitor": "tsc -p monitor/tsconfig.json",
    "monitor": "node monitor/dist/run.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "notification",
    "notifier",
    "webhook",
    "slack",
    "discord",
    "cli",
    "claude"
  ],
  "author": "joebrashear100 <joebrashear100@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joebrashear100/claude-notify.git"
  },
  "homepage": "https://github.com/joebrashear100/claude-notify#readme",
  "bugs": {
    "url": "https://github.com/joebrashear100/claude-notify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
